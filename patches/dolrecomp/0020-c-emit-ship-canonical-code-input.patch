+                return 0;
+            }
+        }
+        size += 16u + (size_t)section->size;
+    }
+    capture->data = (u8*)malloc(size);
+    if (!capture->data) {
+        fprintf(stderr, "error: out of memory capturing ship code input\n");
+        return 0;
+    }
+    capture->size = size;
+    memcpy(capture->data, "SHIP168", 8u);
+    write_be32(capture->data + 8u, count);
+    u8* cursor = capture->data + 12u;
